    <string name="dest_appearance">Appearance</string>
    <string name="ap_subtitle">The system status bar everywhere, and how BooxUltimatum home looks</string>
    <string name="ap_statusbar">System status bar</string>
    <string name="ap_statusbar_explain">Choose which icons the status bar shows. This applies across the whole tablet, the Boox home included, through Android’s own status bar setting. The icon designs you pick below are drawn in BooxUltimatum home’s header; the system’s own icon artwork can only be replaced with root.</string>
    <string name="ap_statusbar_note">Icons appear only while their feature is active, so a shown icon may still be absent. The icons’ design belongs to the firmware and can’t be changed without root.</string>
    <string name="ap_restore_boox">Restore Boox defaults</string>
    <string name="ap_show">Show</string>
    <string name="ap_hide">Hide</string>
    <string name="ap_battery_pct">Battery percentage</string>
    <string name="ap_battery_pct_with_icon">Hidden with the battery icon: Android draws the figure inside it, so the figure can’t show on its own.</string>
    <string name="ap_all_icons">Show all %d icons</string>
    <string name="ap_text">Text</string>
    <string name="ap_text_explain">E-ink thins every stroke, so BooxUltimatum and its home set text one weight heavier than designed. Choose how heavy.</string>
    <string name="ap_text_weight">Weight</string>
    <string name="ap_weight_designed">As designed</string>
    <string name="ap_weight_heavier">Heavier</string>
    <string name="ap_weight_heaviest">Heaviest</string>
    <string name="ap_text_note">Home follows the tablet font at every weight, even variable fonts whose lightest cut Android would otherwise pick. To change the font of the whole tablet, open a family in Fonts and choose Use on the whole tablet.</string>
    <string name="ap_fewer_icons">Show common icons only</string>
    <string name="ap_home">BooxUltimatum home</string>
    <string name="ap_home_explain">Changes apply the next time home appears. Arranging the grid, widgets and folders stays in home’s Edit.</string>
