    <!-- Home screen (launcher) switcher -->
    <string name="plate_home">Home screen</string>
    <string name="home_explain">Try another launcher without losing anything. The Boox home stays one tap away, and every Boox function is listed below so no feature gets stranded.</string>
    <string name="home_boox">Boox home: library, notes, function bar and widgets</string>
    <string name="home_other">Another launcher</string>
    <string name="home_ours_desc">This app’s e-ink home: widgets, folders, paged grid, light on memory</string>
    <string name="home_current">In use</string>
    <string name="action_use_launcher">Use this</string>
    <string name="action_back_to_boox">Back to Boox</string>
    <string name="home_only_boox">Only the Boox home is installed. Install any launcher, then come back here to try it with a safe way back.</string>
    <string name="home_needs_shizuku">Switching in one tap needs Shizuku. Without it, Android’s own Home app page does the same.</string>
    <string name="action_home_settings">Android Home app page</string>
    <string name="home_shortcuts">Boox functions · %1$d</string>
    <string name="home_shortcuts_explain">Open any Boox app from here, whichever launcher is in use.</string>

    <!-- Background restriction set by Boox (verified on NA6C FW 4.3: RUN_ANY_IN_BACKGROUND=ignore on Apple Music, Discord, YouTube) -->
    <string name="tgroup_apps">Apps you install</string>
    <string name="tgroup_apps_explain">Boox quietly stops some apps you install from running in the background. Music stops a minute after you leave the player, and screen sharing goes blank.</string>
    <string name="tw_user_bg_title">Let your apps keep running</string>
    <string name="tw_user_bg_summary">Lifts the background restriction Boox placed on apps you installed, so music keeps playing and calls and screen shares survive leaving the app.</string>
    <string name="tw_note_user_bg">Uses a little more battery for those apps. To choose app by app, use Apps → Restricted instead.</string>
    <string name="filter_restricted">Restricted · %1$d</string>
    <string name="filter_restricted_explain">Apps you installed that Boox won’t let run in the background. Open one and tap Keep running to fix music that stops or calls that drop.</string>
    <string name="tag_bg_restricted">Restricted</string>
    <string name="app_bg_restricted_note">Boox restricts this app in the background, which is why playback, calls or sharing stop soon after you leave it. Keep running lifts that. If Boox puts it back after a restart, tap it again.</string>

