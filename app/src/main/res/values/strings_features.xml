    <string name="tgroup_sleep">Sleep</string>
    <string name="tgroup_sleep_explain">How the tablet rests when the screen is off. This is where standby drain is won or lost.</string>
    <string name="tgroup_power">Power</string>
    <string name="tgroup_power_explain">Everyday switches that trade a little convenience for charge.</string>
    <string name="tgroup_radios">Radios</string>
    <string name="tgroup_radios_explain">Background scanning that keeps radios busy even when Wi-Fi and Bluetooth look off.</string>
    <string name="tgroup_interface">Interface</string>
    <string name="tgroup_interface_explain">Changes that suit an e-ink panel better than Android’s phone defaults.</string>
    <string name="tgroup_privacy">Privacy</string>
    <string name="tgroup_privacy_explain">Quieter networking and fewer Onyx services calling home.</string>

    <string name="tw_doze_title">Turn on Doze</string>
    <string name="tw_doze_summary">This firmware ships with Android’s deep sleep switched off. Turning it on lets the tablet rest properly while the screen is off.</string>
    <string name="tw_note_resets">Android forgets this on restart. Apply it again after restarting.</string>
    <string name="tw_allowlist_title">Let Boox apps sleep</string>
    <string name="tw_allowlist_summary">Takes non-essential Onyx apps off the list of apps Doze never pauses. Keyboards, launcher, NaviBall, clock and players stay exempt.</string>
    <string name="tw_note_allowlist">Boox may put them back after a restart; check this again then.</string>
    <string name="tw_background_title">Pause idle Boox apps</string>
    <string name="tw_background_summary">Stops the store, shop, transfer, factory test, AI assistant, calculator, gallery, dictionary and calibration apps running in the background.</string>

    <string name="tw_saver_title">Battery Saver</string>
    <string name="tw_saver_summary">Android’s own saver: limits background work and syncing across all apps.</string>
    <string name="tw_adaptive_title">Adaptive battery</string>
    <string name="tw_adaptive_summary">Keeps App Standby on, so apps you rarely open get fewer chances to run.</string>
    <string name="tw_sync_title">Stop automatic sync</string>
    <string name="tw_sync_summary">Accounts stop syncing on their own. Apps still sync when you open them.</string>
    <string name="tw_timeout_title">Sleep after 2 minutes</string>
    <string name="tw_timeout_summary">Turns the screen off after 2 minutes of no touch. Undo restores your previous timeout.</string>
    <string name="tw_stay_awake_title">Don’t stay awake while charging</string>
    <string name="tw_stay_awake_summary">Lets the screen turn off while plugged in, even with developer options on.</string>

    <string name="tw_wifi_scan_title">Stop Wi-Fi scanning</string>
    <string name="tw_wifi_scan_summary">Android keeps scanning for Wi-Fi to help location even when Wi-Fi is off. This stops it.</string>
    <string name="tw_ble_scan_title">Stop Bluetooth scanning</string>
    <string name="tw_ble_scan_summary">Stops background Bluetooth scans for nearby devices while Bluetooth is off.</string>
    <string name="tw_wifi_wakeup_title">Don’t turn Wi-Fi back on</string>
    <string name="tw_wifi_wakeup_summary">Stops Wi-Fi switching itself on near saved networks.</string>
    <string name="tw_location_title">Turn off location</string>
    <string name="tw_location_summary">Switches location services off for every app.</string>

    <string name="tw_animations_title">Turn off animations</string>
    <string name="tw_animations_summary">Sets window, transition and animator speeds to off. Screens change in one clean refresh instead of a smear of frames.</string>

    <string name="tw_dns_title">Block trackers with private DNS</string>
    <string name="tw_dns_summary">Routes name lookups through AdGuard DNS, which drops known ad and tracking domains for every app.</string>
    <string name="tw_note_dns">Some hotel and café sign-in pages need this undone to load.</string>
    <string name="tw_ota_title">Pause Boox update checks</string>
    <string name="tw_ota_summary">Disables the Onyx updater service. Nothing is uninstalled.</string>
    <string name="tw_note_ota">You won’t hear about firmware updates until you undo this.</string>
    <string name="tw_store_title">Disable the Boox store and shop</string>
    <string name="tw_store_summary">Disables the App Store and shop apps. Nothing is uninstalled.</string>
    <string name="tw_factory_title">Disable the factory test app</string>
    <string name="tw_factory_summary">A production-line test tool with no use after the tablet leaves the factory.</string>

