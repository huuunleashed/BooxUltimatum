<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- T0: inventory of installed packages (sideloaded app, not Play-distributed). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- T1: granted once via `adb shell pm grant` / `appops set`. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- T0: master auto-sync switch (normal permissions). -->
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <!-- Weather (Open-Meteo) and Google Fonts downloads. Nothing else talks to the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Launcher: agenda and month widgets (asked at runtime), and the uninstall action. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- In-app updates: Android still asks the owner unless this app is allowed to install packages. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Launcher indicators (normal permissions): Wi-Fi on/connected state. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Battery log: re-arm the non-wakeup sampling alarm after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Instant ink: a small foreground service, so Android doesn't freeze it behind the drawing app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      Live sleep screen: an exact wake-up alarm every few minutes while asleep, and a short wake lock while the face
      renders. USE_EXACT_ALARM is granted with the app (Android 13+); older versions grant SCHEDULE_EXACT_ALARM.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".BooxUltimatumApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BooxUltimatum">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The launcher. The activity itself has no HOME filter; the alias below carries it and ships disabled,
          so installing this app never offers a second home or prompts a chooser. It is switched on from
          Settings > Home screen.
        -->
        <activity
            android:name=".launcher.LauncherActivity"
            android:exported="false"
            android:label="@string/launcher_name"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:taskAffinity="app.booxultimatum.home"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|locale|layoutDirection"
            android:theme="@style/Theme.BooxUltimatum" />

        <activity-alias
            android:name=".launcher.Home"
            android:targetActivity=".launcher.LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/launcher_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <receiver android:name=".core.BatteryLogReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <action android:name="app.booxultimatum.action.LOG_SAMPLE" />
            </intent-filter>
        </receiver>

        <!-- Sleep screen studio: the non-wakeup refresh alarm. -->
        <receiver android:name=".core.sleep.SleepReceiver" android:exported="false" />

        <!-- Live sleep screen: the wake-up alarm while asleep, and the overlay over Boox's sleep screen. -->
        <receiver android:name=".core.sleep.LiveSleepReceiver" android:exported="false" />
        <service
            android:name=".core.sleep.LiveSleepService"
            android:exported="true"
            android:label="@string/live_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/live_sleep_service" />
        </service>

        <!-- In-app updates: receives PackageInstaller results and launches Android's confirmation screen when needed. -->
        <receiver android:name=".core.update.UpdateInstallReceiver" android:exported="false" />

        <service
            android:name=".core.ink.InkService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Low-latency stylus preview for drawing apps the user picks" />
        </service>

        <service
            android:name=".core.ink.InkTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_ink"
            android:label="@string/ink_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/shared_paths" />
        </provider>
    </application>
</manifest>
