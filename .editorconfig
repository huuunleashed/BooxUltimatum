root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# Prose is never hard-wrapped (see CONTRIBUTING.md); keep intentional two-space line breaks.
max_line_length = off
trim_trailing_whitespace = false

[*.{kts,gradle,xml,json,yml,yaml}]
indent_size = 4

[*.ps1]
end_of_line = crlf
