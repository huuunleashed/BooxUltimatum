    <!-- Settings -->
    <string name="settings_tab_writing">书写</string>
    <string name="settings_tab_writing_detail">笔、橡皮端，以及完成的墨迹何时取代预览</string>
    <string name="settings_tab_display">显示</string>
    <string name="settings_tab_display_detail">显示屏如何预览你的笔，以及如何刷新屏幕。</string>
    <string name="settings_tab_fingers_detail">手指在页面上的作用。</string>
    <string name="settings_tab_layout">布局</string>
    <string name="settings_tab_layout_detail">工具和卡片的位置</string>
    <string name="settings_refresh">刷新</string>
    <string name="settings_preview_size">预览大小</string>
    <string name="settings_tools">工具</string>
    <string name="setting_eraser_end">预览橡皮端</string>
    <string name="setting_eraser_end_detail">擦除时，显示屏会立即画出橡皮端的轨迹，抬笔时 Nib 才真正擦除。这只在即时墨迹开启时有效。关闭开关时，页面会随着你擦除逐段更新，速度较慢。</string>
    <string name="settings_instant_ink">即时墨迹（实验性）</string>
    <string name="setting_instant_ink">即时墨迹</string>
    <string name="setting_instant_ink_detail">书写时，显示屏会像 Boox 自带的应用那样自己画出你的笔画，墨迹因此立刻出现。只有平板固件提供这一功能时才能用，而且它仍在实验阶段。如果笔画显示异常或留下痕迹，请关闭它。</string>
    <string name="setting_instant_ink_on_note">下次打开画作时生效。</string>
    <string name="setting_instant_ink_off_note">关闭即时墨迹时，每一笔都由 Nib 自己绘制，速度会稍慢一些。此处和“显示”页面上的预览设置都不起作用。下次打开画作时生效。</string>
    <string name="settings_pen">笔</string>
    <string name="settings_fingers">手指</string>
    <string name="settings_panels">卡片</string>
    <string name="settings_panels_detail">你拖动的卡片会留在放下它们的位置，横屏和竖屏各记各的。</string>
    <string name="settings_panels_reset">把每张卡片恢复到它的按钮旁</string>
    <string name="settings_panels_done">每张卡片都已恢复到它的按钮旁</string>
    <string name="settings_preview">显示屏预览</string>
    <string name="setting_marker_preview">马克笔和荧光笔的预览</string>
    <string name="setting_marker_preview_detail">显示屏自带的预览在多数颜色下无法半透明（在 Note Air6 C 上测得）。请在半透明灰色和实色之间选择。</string>
    <string name="marker_preview_grey">半透明灰色</string>
    <string name="marker_preview_grey_detail">和你的颜色一样淡的半透明灰色。笔画下方的内容依然可见，抬笔时才显现出你的颜色。</string>
    <string name="marker_preview_solid">实色</string>
    <string name="marker_preview_solid_detail">大致是你的颜色，覆盖笔画下方的内容，直到你抬笔。在 Note Air6 C 上，蓝色显示为灰色，很浅的颜色可能不显示。</string>
    <string name="settings_preview_detail">如果显示屏的预览看起来比取代它的笔画更宽或更细，你可以让两者一致。轻触下方的按钮，在“诊断”中打开“匹配预览”。</string>
    <string name="setting_straight">按住可画直线</string>
    <string name="setting_straight_detail">在笔画末尾停笔半秒，这一笔就会变成从起点到终点的直线。在平板上，显示屏按画出的样子预览这条笔画，抬笔时直线会取代它。</string>
    <string name="setting_left_handed">工具放在右侧</string>
    <string name="setting_left_handed_detail">把笔、工具和滑块移到右边缘。这适合左手绘画。</string>
    <string name="setting_finger_drawing">用手指绘画</string>
    <string name="setting_finger_drawing_detail">允许手指与笔一样绘画。关闭时，手指只能移动页面，只有笔能绘画。</string>
    <string name="setting_finger_pan">单指移动页面</string>
    <string name="setting_finger_pan_detail">手指不绘画时此项有效。双指始终可捏合缩放，也可移动和旋转页面。</string>
    <string name="setting_fast_gestures">移动时快速刷新</string>
    <string name="setting_fast_gestures_detail">手指移动、缩放或旋转页面，以及你拖动选区时，显示屏会像 Boox 自带的应用那样切换到快速模式。停下后屏幕会被清理干净。这只在即时墨迹开启时有效。</string>
    <string name="setting_palm_guard">防掌误触</string>
    <string name="setting_palm_guard_detail">笔靠近时，显示屏会忽略画布上的手指触摸，因此放在画上的手不会移动页面。这只在即时墨迹开启时有效。此功能尚未验证，请先在“诊断 › 实验”中试用。</string>
    <string name="setting_reveal">显示完成的墨迹</string>
    <string name="setting_reveal_detail">书写时，显示屏会为每一笔画出自己的快速预览，Nib 完成的墨迹会取代它。请选择取代的时刻。</string>
    <string name="reveal_auto">自动</string>
    <string name="reveal_auto_detail">由 Nib 替你决定：显示屏能忠实预览的笔用“停顿时”，有纹理、混合和半透明的笔用“停笔后”。</string>
    <string name="reveal_breaks">停顿时</string>
    <string name="reveal_breaks_detail">当你触碰控件、打开卡片、移动页面或撤销时，完成的墨迹会取代预览，与 Boox Notes 相同。快速书写依然最快。</string>
    <string name="reveal_pause">停笔后</string>
    <string name="reveal_pause_detail">笔一停下，Nib 就把完成的墨迹显示在屏幕上，不会打断你。停顿的时长在下方设置。</string>
    <string name="reveal_every">每笔之后</string>
    <string name="reveal_every_detail">你一抬笔，完成的墨迹就会取代这一笔的预览。这会拖慢快速书写。</string>
    <string name="setting_reveal_pause">显示完成墨迹前的停顿</string>
    <string name="setting_gestures">双指轻触可撤销，三指轻触可重做。笔靠近屏幕时，手指操作会被忽略。</string>

