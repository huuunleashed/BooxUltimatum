    <string name="suite_apps">Apps</string>
    <string name="suite_apps_explain">Separate apps that build on BooxUltimatum. Each installs, updates and uninstalls on its own, and works without this app.</string>
    <string name="suite_modules">Built into BooxUltimatum</string>
    <string name="suite_modules_explain">Removing a module stops it and undoes what it changed on the tablet, and its pages leave the menu. Add it back at any time.</string>
