    <!-- The Logs page. -->
    <string name="logs_title">Logs</string>
    <string name="logs_subtitle">What every suite app recorded, kept on this tablet</string>
    <string name="logs_explain">Each app keeps a log of what it did and what went wrong, including crashes, for about two weeks. The logs hold no drawings, typed text, or account and network names, and nothing leaves the tablet unless you share it.</string>
