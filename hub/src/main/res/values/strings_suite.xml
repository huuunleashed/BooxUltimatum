    <!-- The Storage page. -->
    <string name="dest_storage">Storage</string>
    <string name="storage_title">Storage</string>
    <string name="storage_subtitle">%1$s kept by the suite’s apps</string>
    <string name="storage_explain">Each app keeps its own leftovers in check by itself: cache files go after three days, downloaded updates after a day, shared exports after a week, and logs stay under 8 MB and two weeks. Drawings, fonts, the battery log and settings are yours, so they’re counted here but never cleared.</string>
