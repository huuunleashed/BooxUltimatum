    <string name="access_subtitle">What BooxUltimatum may do on this tablet. Each level unlocks more tweaks.</string>
    <string name="tier_app">App</string>
    <string name="tier_app_short">Readings any app can take</string>
    <string name="tier_app_state">Installed</string>
    <string name="tier_app_explain">Battery, tablet and app readings that need no special permission.</string>
    <string name="tier_adb">adb grants</string>
    <string name="tier_adb_count">%1$d of %2$d granted from a computer</string>
    <string name="tier_adb_explain">Permissions you grant once from a computer with adb, Android’s debugging tool, over USB. They stay in place after a restart.</string>
    <string name="grant_secure_settings">Change system settings</string>
    <string name="grant_secure_settings_why">Needed to apply and undo settings tweaks.</string>
    <string name="grant_dump">Read system diagnostics</string>
    <string name="grant_dump_why">Needed to see which apps wake the tablet.</string>
    <string name="grant_logs">Read system logs</string>
    <string name="grant_logs_why">Needed to trace wakeups back to their cause.</string>
    <string name="grant_usage">Usage access</string>
    <string name="grant_usage_why">Needed to know which apps you actually use.</string>
    <string name="grant_how">Grant them by running these adb commands on a computer connected to the tablet:</string>
    <string name="tier_shizuku">Shizuku</string>
    <string name="tier_shizuku_explain">Shizuku is a separate app. Once it runs, it lets BooxUltimatum act with the same rights as adb, without a computer. It stops when the tablet restarts, and starting it again needs a computer.</string>
    <string name="shizuku_server">Shizuku service</string>
