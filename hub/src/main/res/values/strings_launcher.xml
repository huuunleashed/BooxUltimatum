    <string name="dest_appearance">Appearance</string>
    <string name="ap_subtitle">The status bar across the tablet, and how BooxUltimatum home looks</string>
    <string name="ap_statusbar">System status bar</string>
    <string name="ap_statusbar_explain">Choose which icons the status bar shows, on the whole tablet and in the Boox home too. This needs Shizuku or the adb grants, and without them BooxUltimatum shows an error. The icon designs you choose below only change the header of BooxUltimatum home.</string>
    <string name="ap_statusbar_note">An icon appears only while its feature is active, so a shown icon can still be missing. The firmware draws the designs, and changing them needs root, so BooxUltimatum can only show or hide icons.</string>
    <string name="ap_restore_boox">Restore Boox defaults</string>
    <string name="ap_show">Show</string>
    <string name="ap_hide">Hide</string>
    <string name="ap_battery_pct">Battery percentage</string>
    <string name="ap_battery_pct_with_icon">Hidden with the battery icon. Android draws the percentage inside the icon, so it can’t show without it.</string>
    <plurals name="ap_all_icons">
        <item quantity="one">Show the one icon</item>
        <item quantity="other">Show all %d icons</item>
    </plurals>
    <string name="ap_text">Text</string>
    <string name="ap_text_explain">E-ink can make text look thin, so by default text in BooxUltimatum and BooxUltimatum home is one weight heavier than designed. Choose how heavy it is.</string>
    <string name="ap_text_weight">Weight</string>
    <string name="ap_weight_designed">As designed</string>
    <string name="ap_weight_heavier">Heavier</string>
    <string name="ap_weight_heaviest">Heaviest</string>
    <string name="ap_text_note">BooxUltimatum home follows the tablet font at every weight. Some fonts are one variable file, and Android would otherwise pick their lightest weight. To change the font of the whole tablet, open a font in Fonts and choose Use on the whole tablet.</string>
    <string name="ap_fewer_icons">Show common icons only</string>
    <string name="ap_home">BooxUltimatum home</string>
    <string name="ap_home_explain">Changes apply the next time home appears. To arrange the grid, widgets and folders, tap Arrange home, the pencil button in home’s header.</string>
    <string name="ap_wall_failed">That picture couldn’t be read.</string>
    <string name="ap_more_fonts">Download more fonts for BooxUltimatum and its home in Fonts.</string>
    <string name="ap_wifi_symbol">Wi-Fi symbol</string>
    <string name="ap_battery_symbol">Battery symbol</string>
    <string name="ap_symbols_note">Each Wi-Fi design is shown strong, weak and off, and each battery design charging, half full and low. They appear only in the header of BooxUltimatum home. The system status bar keeps the firmware’s own icons.</string>
