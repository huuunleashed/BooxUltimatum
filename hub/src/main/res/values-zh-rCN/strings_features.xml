    <string name="tw_note_saver">充电时 Android 会保持省电模式关闭，拔掉电源后它才会生效。</string>
    <string name="tgroup_sleep">睡眠</string>
    <string name="tgroup_sleep_explain">息屏后平板的休息方式。这些调整项会影响待机耗电。</string>
    <string name="tgroup_power">电源</string>
    <string name="tgroup_power_explain">日常设置，牺牲一些便利以降低耗电。</string>
    <string name="tgroup_radios">无线</string>
    <string name="tgroup_radios_explain">即使看起来已关闭，后台扫描仍会让 Wi-Fi 和蓝牙保持活跃。</string>
    <string name="tgroup_interface">界面</string>
    <string name="tgroup_interface_explain">这些更改比 Android 的手机默认设置更适合墨水屏。</string>
    <string name="tgroup_privacy">隐私</string>
    <string name="tgroup_privacy_explain">拦截跟踪器，关闭你可能不需要的 Boox 服务。</string>
    <string name="tw_doze_title">开启 Doze</string>
    <string name="tw_doze_summary">开启 Android 的深度睡眠（称为 Doze），固件默认将其关闭（已在 Note Air6 C 上确认）。这样平板在息屏后就能暂停后台工作。</string>
    <string name="tw_note_resets">平板重启后 Android 会忘记此项设置，之后请重新应用。</string>
    <string name="tw_allowlist_title">让 Boox 应用休眠</string>
    <string name="tw_allowlist_summary">把非必要的 Boox 应用移出“Doze 永不休眠”名单。键盘、主屏幕、NaviBall、时钟、音乐播放器和录音机仍保留在名单上。</string>
    <string name="tw_note_allowlist">重启后 Boox 可能会把它们加回来。届时请重新检查此调整项。</string>
    <string name="tw_background_title">暂停闲置的 Boox 应用</string>
    <string name="tw_background_summary">阻止 Boox 商店、商城、传输、工厂测试、AI 助手、计算器、图库、词典和校准应用在后台运行。</string>
    <string name="tw_saver_title">省电模式</string>
    <string name="tw_saver_summary">开启 Android 自带的省电模式，它会限制所有应用的后台工作和同步。</string>
    <string name="tw_adaptive_title">自适应电池</string>
    <string name="tw_adaptive_summary">保持 Android 的应用待机功能开启，因此你很少打开的应用在后台运行的机会更少。</string>
    <string name="tw_sync_title">停止自动同步</string>
    <string name="tw_sync_summary">关闭 Android 的自动账户同步。账户不再自行同步，打开应用时仍会同步。</string>
    <string name="tw_timeout_title">2 分钟后休眠</string>
    <string name="tw_timeout_summary">2 分钟无触摸操作后关闭屏幕。撤销后将恢复为之前的超时时间。</string>
    <string name="tw_stay_awake_title">充电时不要保持唤醒</string>
    <string name="tw_stay_awake_summary">允许平板在充电时自动息屏。此项会关闭 Android 的“保持唤醒”开发者选项。</string>
    <string name="tw_wifi_scan_title">停止 Wi-Fi 扫描</string>
    <string name="tw_wifi_scan_summary">即使 Wi-Fi 已关闭，Android 也能扫描 Wi-Fi 网络以改善定位。此项会阻止这种行为。</string>
    <string name="tw_ble_scan_title">停止蓝牙扫描</string>
    <string name="tw_ble_scan_summary">在蓝牙关闭时停止后台扫描附近的设备。</string>
    <string name="tw_wifi_wakeup_title">不要重新开启 Wi-Fi</string>
    <string name="tw_wifi_wakeup_summary">阻止 Wi-Fi 在已保存的网络附近自动开启。</string>
    <string name="tw_location_title">关闭定位</string>
    <string name="tw_location_summary">为所有应用关闭位置服务，因此在撤销此项之前，需要定位的应用无法获取你的位置。</string>
    <string name="tw_animations_title">关闭动画</string>
    <string name="tw_animations_summary">关闭 Android 的窗口、过渡和动画效果。页面切换只需一次干净的刷新，而不是一串拖影的帧。</string>
    <string name="tw_dns_title">用私人 DNS 拦截跟踪器</string>
    <string name="tw_dns_summary">让所有应用的网址查询都经由 AdGuard DNS，它会拦截已知的广告和跟踪域名。</string>
    <string name="tw_note_dns">在撤销此项之前，部分酒店和咖啡馆的 Wi-Fi 登录页面将无法加载。</string>
    <string name="tw_ota_title">暂停 Boox 更新检查</string>
    <string name="tw_ota_summary">关闭 Boox 更新服务。不会卸载任何内容。</string>
    <string name="tw_note_ota">在撤销此项之前，你不会收到固件更新的通知。</string>
    <string name="tw_store_title">关闭 Boox 商店和商城</string>
    <string name="tw_store_summary">关闭 Boox 应用商店和商城应用，它们不再打开或运行。不会卸载任何内容。</string>
    <string name="tw_factory_title">关闭工厂测试应用</string>
    <string name="tw_factory_summary">关闭产线测试工具，平板出厂后它毫无用处。不会卸载任何内容。</string>
