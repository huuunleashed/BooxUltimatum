    <string name="plate_home">桌面</string>
    <string name="home_explain">换用其他主屏幕应用，不会丢失任何东西。Boox 主屏幕仍只需轻触一下即可返回，下面列出了所有 Boox 功能，因此没有一项会无法使用。</string>
    <string name="home_boox">Boox 主屏幕：书库、笔记、功能栏和小组件</string>
    <string name="home_other">其他主屏幕应用</string>
    <string name="home_ours_desc">BooxUltimatum 的墨水屏主屏幕：小组件、文件夹、分页网格和低内存占用</string>
    <string name="home_current">使用中</string>
