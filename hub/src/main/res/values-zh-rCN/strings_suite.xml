    <string name="suite_title">BooxUltimatum 套件</string>
    <string name="suite_subtitle">你安装的应用，以及内置于 BooxUltimatum 的模块</string>
    <string name="suite_apps">应用</string>
    <string name="suite_apps_explain">基于 BooxUltimatum 构建的独立应用。每个都能自行安装、更新和卸载，没有 BooxUltimatum 也能运行。BooxUltimatum 会从 GitHub Releases 下载它们，并在安装前进行校验。</string>
    <string name="suite_modules">内置于 BooxUltimatum</string>
    <string name="suite_modules_explain">移除模块会将其停用，撤销它在平板上所做的更改，并把相关页面从菜单中移除。你随时可以重新添加。</string>
